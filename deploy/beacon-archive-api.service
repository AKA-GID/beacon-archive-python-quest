[Unit]
Description=Beacon Archive Python quest API
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/codex/beacon-archive-python-quest/server
Environment=TEAM_API_HOST=127.0.0.1
Environment=TEAM_API_PORT=8766
Environment=TEAM_API_DB=/home/codex/beacon-archive-python-quest/server/progress.sqlite3
ExecStart=/usr/bin/python3 app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
